# ---------------------------------------------------------------- Python
__pycache__/
*.pyc
*.so
_ext
.pytest_cache/
.ruff_cache/

# ------------------------------------------------------- model artefacts
# Weights and serialised tensors are downloaded or produced, never committed.
*.pt
*.pth
*.pkl
*.npy
*.zip

# ------------------------------------------------------------ logs, notes
*.log
**/events.*
*.ipynb
**/.ipynb_checkpoints/
note*.md

# -------------------------------------------------------------- editors
.idea
.vscode
.DS_Store

# ------------------------------------------------------ data and outputs
# Everything under data/ is downloaded or generated by tools/prepare_data.py
# (~47 GB). data/**/ is re-included so that the negations below can work: git
# cannot re-include a file whose parent directory is excluded.
data/**
!data/**/
!data/**/README.md
!data/**/readme.md

# NOTE: comments must be on their own line. A trailing "# ..." after a pattern
# is part of the pattern, which is why output/ and ops/build/ silently failed
# to match before.
output/
ops/build/
ops/dist/
ops/*.egg-info/

# Large caches that sit inside tracked package directories, so the *.pth /
# *.pkl rules above are not enough on their own.
vlm/backbones/alpro_weights/
models/cache/

# Papers: 18 MB of third-party PDFs. Kept locally for reference, not committed —
# they are copyrighted and this repo has a public remote.
_paper/

# Derived pilot artefacts. Regenerate rather than track:
#   python pilot_analysis/scripts/gt_trajectories.py --mode strict --dump
pilot_analysis/gt_trajectories.json

# Run logs stay local. They are the protocol's ground-rule-5 audit trail and are
# kept on disk, but they are machine-specific (absolute paths, driver versions)
# and one of them -- the HuggingFace upload log -- reached 8.85 MB of
# carriage-return progress bars. Regenerate with pilot_analysis/logs/commands.md.
pilot_analysis/logs/

# The pilot's prediction dumps (228 MB): kept locally, never committed. The one
# file a GPU session needs (segments_raw_all.json) is copied to the box directly.
pilot_analysis/preds_from_pod/

# Option-A train tracks: superseded by preregistration amendment A5. gt_tracks.py
# rewrites this on every run (the script's hash is pinned, so it stays as is).
pilot_analysis/stage1c/gt_tracks_train_optionA.json
