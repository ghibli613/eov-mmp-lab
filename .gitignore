# ---------------------------------------------------------------- Python
__pycache__/
*.pyc
*.so
_ext
.pytest_cache/
.ruff_cache/

# ------------------------------------------------------- model artefacts
# Weights and serialised tensors are downloaded or produced, never committed.
*.pt
*.pth
*.pkl
*.npy
*.zip

# ------------------------------------------------------------ logs, notes
*.log
**/events.*
*.ipynb
**/.ipynb_checkpoints/
note*.md

# -------------------------------------------------------------- editors
.idea
.vscode
.DS_Store

# ------------------------------------------------------ data and outputs
# Everything under data/ is downloaded or generated by tools/prepare_data.py
# (~47 GB). data/**/ is re-included so that the negations below can work: git
# cannot re-include a file whose parent directory is excluded.
data/**
!data/**/
!data/**/README.md
!data/**/readme.md

# NOTE: comments must be on their own line. A trailing "# ..." after a pattern
# is part of the pattern, which is why output/ and ops/build/ silently failed
# to match before.
output/
ops/build/
ops/dist/
ops/*.egg-info/

# Large caches that sit inside tracked package directories, so the *.pth /
# *.pkl rules above are not enough on their own.
vlm/backbones/alpro_weights/
models/cache/
